{
  "name": "struktura-crm",
  "version": "0.2.1",
  "private": true,
  "description": "Локальная CRM для демонтажа, отделки и фальшполов",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "dist:win": "electron-builder --win nsis"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1"
  },
  "devDependencies": {
    "electron": "^35.2.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "ru.struktura.crm",
    "productName": "Struktura CRM",
    "asar": true,
    "files": ["src/**/*", "package.json"],
    "win": { "target": ["nsis"], "artifactName": "Struktura-CRM-Setup-${version}.${ext}" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "createStartMenuShortcut": true }
  }
}